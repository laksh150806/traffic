# Copy to .env.local (git-ignored) and edit.

# simulated (default): the whole network is simulated in the browser, no backend needed.
# live: read and write your own Supabase project.
VITE_DATA_MODE=simulated

# Live mode only. Use your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Live mode only, server side. Never prefix with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Live mode, running the control loop without a browser open (see README, "Keeping the loop running").
# A secret of 16+ characters. The scheduler sends it as `Authorization: Bearer <secret>`.
CONTROL_CRON_SECRET=
# Set to false once a scheduler is running: the open-to-anyone browser endpoints then do nothing.
CONTROL_BROWSER_DRIVEN=true
# Set to false so open tabs stop calling the control endpoints at all (pair with the line above).
VITE_BROWSER_DRIVES_LOOP=true

# The server also accepts VITE_SUPABASE_URL when SUPABASE_URL is not set, so one URL is enough.
