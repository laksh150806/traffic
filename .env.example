# Copy to .env.local (git-ignored) and edit.

# demo (default): the whole network is simulated in the browser, no backend needed.
# live: read and write your own Supabase project.
VITE_DATA_MODE=demo

# Live mode only. Use your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Live mode only, server side. Never prefix with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
